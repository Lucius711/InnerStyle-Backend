# =========================================================================
# InnerStyle deploy env — VPS (Redis + backend), DB Supabase, FE Vercel
# =========================================================================

# --- Database: Supabase (KHÔNG dùng port 6543 transaction pooler) ---
DATABASE_URL=jdbc:postgresql://db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=<mật khẩu DB Supabase, lấy ở Project Settings → Database>

# --- Auth / JWT (bắt buộc đổi) ---
JWT_SECRET=<chạy: openssl rand -base64 48>
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D
# URL frontend thật (Vercel) — dùng build link verify email / reset password
FRONTEND_BASE_URL=https://<ten-app-cua-ban>.vercel.app

# --- CORS: cho phép frontend Vercel gọi API (bắt buộc thêm — không có sẵn trong file mẫu) ---
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://<ten-app-cua-ban>.vercel.app

# --- Refresh token cookie: bắt buộc vì frontend/backend khác domain (bắt buộc thêm) ---
APP_AUTH_REFRESH_COOKIE_SECURE=true
APP_AUTH_REFRESH_COOKIE_SAME_SITE=None

# --- Redis (container nội bộ, không đổi) ---
REDIS_KEY_PREFIX=is:prod
RATE_LIMIT_ENABLED=true

# --- MeshyAI ---
MESHY_API_KEY=<key thật từ meshy.ai, mục Settings → API Keys>
MESHY_BASE_URL=https://api.meshy.ai
MESHY_WEBHOOK_SECRET=<chuỗi random bất kỳ, ví dụ: openssl rand -hex 24>

# --- Social login (optional — bỏ trống nếu không bật Google/Facebook login) ---
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# 2 dòng VITE_* này để build frontend — vì frontend giờ build/deploy trên Vercel,
# không cần đặt ở đây nữa. Đặt trong Environment Variables của project Vercel thay vào đó.

# --- Payment: VNPay ---
VNPAY_TMN_CODE=<mã merchant thật, đăng ký ở VNPay>
VNPAY_HASH_SECRET=<secret thật, VNPay cấp cùng TMN_CODE>
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://<ten-app-cua-ban>.vercel.app/wallet/vnpay-return

# --- Payment: MoMo ---
MOMO_PARTNER_CODE=<mã merchant thật>
MOMO_ACCESS_KEY=<key thật>
MOMO_SECRET_KEY=<secret thật>
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://<ten-app-cua-ban>.vercel.app/wallet/momo-return
# IPN gọi vào BACKEND (VPS), không phải Vercel:
MOMO_IPN_URL=https://<domain-backend-vps-cua-ban>/api/common/payments/momo/ipn